# Copy to .env at the repo root (gitignored). tools/roblox_web.py loads it; a
# value already exported in the shell wins over the file.
#
# --- Non-secret ids --------------------------------------------------------
# Your Roblox user id (the number in your profile URL). The creator that owns
# uploaded assets. Use ROBLOX_GROUP_ID instead to upload under a group.
ROBLOX_USER_ID=
# The HotFrog experience. Universe id: Creator Dashboard -> experience -> "..."
# -> Copy Universe ID (also game.GameId). Place id: the number in the game's
# URL (game.PlaceId). Used by `upload_to_roblox.py --resolve-only --via luau`
# (headless decal->image resolution via tools/luau_exec.py) and as the default
# target for tools/grant_audio_to_experience.py. The place must be published.
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# --- Secrets — never commit, never paste into chat/tickets --------------------
# Open Cloud API key (create.roblox.com -> Creator Hub -> Open Cloud -> API Keys):
#   * Assets API, Read + Write (asset:read / asset:write) — image uploads, --status
#   * Luau Execution "write" for the experience above — only for --via luau
#   add your IP range (or no restriction) under Security.
ROBLOX_API_KEY=
# The logged-in .ROBLOSECURITY cookie of the SAME account (DevTools ->
# Application -> Cookies -> https://www.roblox.com -> .ROBLOSECURITY, raw value,
# no ".ROBLOSECURITY=" prefix). A full login credential. Enables the website
# audio upload path (fast moderation), cookie decal->image resolution,
# list_assets.py and grant_audio_to_experience.py. Expires when you log out.
ROBLOSECURITY=

# Optional: the Unity project's Assets/Audio folder for build_manifest.py
# (defaults to the known-machine path in that script).
# ROBLOX_AUDIO_SRC=C:\path\to\Hawt Frog\Assets\Audio
